# Thai FDA Digital Labeling Platform - Environment Configuration Template
# สำนักงานคณะกรรมการอาหารและยา กระทรวงสาธารณสุข

# Application Configuration
VITE_APP_NAME="ระบบฉลากดิจิทัล อย. — Thai FDA Digital Labeling"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="demo" # demo, staging, production

# Target ASP.NET Core API Base URL (When running with real backend)
VITE_API_BASE_URL="http://localhost:5000/api"

# External Integration Placeholders (Do not insert real production credentials here)
VITE_THAID_CLIENT_ID=""
VITE_THAID_AUTH_URL="https://imauth.bora.dopa.go.th/api/v2/oauth2/token"
VITE_SKYNET_OIDC_URL="https://privus.fda.moph.go.th/connect/authorize"
VITE_E_SUBMISSION_ENDPOINT="https://esubmission.fda.moph.go.th/api/v1"
VITE_GDCC_REGION="th-bkk-1"

# Feature Flags
VITE_FEATURE_ENABLE_AUDIT_LOG="true"
VITE_FEATURE_DEMO_PERSONAS="true"
